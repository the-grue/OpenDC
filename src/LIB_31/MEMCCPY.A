; void *memccpy(void *s1, const void *s2, const char c, size_t n);

	cseg
	public memccpy_
memccpy_:push	bp
	mov	bp,sp

	if	LARGE_CASE

	push	ds
	les	di,[bp+6]
	lds	si,[bp+10]
	mov	dx,[bp+14]
	mov cx,[bp+16]

	else

	mov	ax,ds
	mov	es,ax
	mov	di,[bp+4]
	mov	si,[bp+6]
	mov	dx,[bp+8]
	mov cx,[bp+10]

	endif

	jcxz none
	cld
l:	lodsb
	stosb
	cmp	al,dl
	je	done
	loop l

	if	LARGE_CASE

none:	pop ds
	xor	si,si
	mov es,si
	pop bp
	lret

done:	pop	ds
	dec	di
	mov si,di
	pop	bp
	lret

	else

none:	xor ax,ax
	pop	bp
	ret

done:	mov	ax,di
	dec	ax
	pop	bp
	ret

	endif
